# =============================================================================
# Piston Engine Digital Twin — Environment Variables
# Copy to .env and adjust as needed.
# =============================================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Configuration ---
CONFIG_PATH=config/default.yaml

# --- Database ---
# SQLite for development (no external DB needed)
DATABASE_URL=sqlite+aiosqlite:///./digital_twin.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/digital_twin

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# --- Telemetry ---
TELEMETRY_SOURCE=simulator
# Options: simulator, csv_replay, live
CSV_REPLAY_PATH=data/sample_flights/

# --- ML Models ---
MODEL_DIR=models/
